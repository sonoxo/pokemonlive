  "governance": {
    "battleOutcomeAuthority": "rules-engine",
    "agentAuthority": "presentation-orchestration-only",
    "mayMutateBattleOutcome": false,
    "mayDeclareWinner": false,
    "externalSecretsClientSide": false
  },
  "checks": [
    "npm test",
    "npm run gpt-doug:check"
  ]
